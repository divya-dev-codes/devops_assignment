resource "aws_db_subnet_group" "postgres" {
  name = "postgres-subnet-group"

  subnet_ids = [
    aws_subnet.private_subnet_1.id,
    aws_subnet.private_subnet_2.id
  ]
}

resource "aws_db_instance" "postgres" {
  identifier        = "devops-postgres"
  allocated_storage = 20
  storage_type      = "gp3"
  storage_encrypted = true

  engine         = "postgres"
  engine_version = "15"

  instance_class = "db.t3.micro"

  db_name = "appdb"

  # Password is generated by RDS and stored in AWS Secrets Manager.
  # No db_password variable or tfvars entry is needed anymore.
  username                    = var.db_username
  manage_master_user_password = true

  publicly_accessible = false

  backup_retention_period = 7
  backup_window           = "21:00-22:00" # UTC (02:30-03:30 IST)
  deletion_protection     = true

  db_subnet_group_name = aws_db_subnet_group.postgres.name

  vpc_security_group_ids = [
    aws_security_group.rds_sg.id
  ]

  # Take a final snapshot on destroy (consistent with deletion_protection).
  skip_final_snapshot       = false
  final_snapshot_identifier = "devops-postgres-final-snapshot"
}